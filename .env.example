GEMINI_API_KEY=your_google_ai_studio_api_key
# Optional image fallback used when Gemini image generation returns a quota error.
# Create a Hugging Face token with Inference Providers permission and accept the model access terms.
HF_TOKEN=your_huggingface_token
# Optional; defaults to black-forest-labs/FLUX.1-schnell
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Printify Personal Access Token (server-side only; never use a VITE_ prefix)
PRINTIFY_API_TOKEN=your_printify_personal_access_token
